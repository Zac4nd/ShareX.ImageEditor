<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ShareX.ImageEditor.Presentation.ViewModels"
             xmlns:controls="using:ShareX.ImageEditor.Presentation.Controls"
             x:Class="ShareX.ImageEditor.Presentation.Views.EditorBuiltInToolbars"
             x:DataType="vm:MainViewModel">
    <UserControl.Styles>
        <Style Selector="Button.toolbar-button">
            <Setter Property="Width" Value="32"/>
            <Setter Property="MinWidth" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="MinHeight" Value="32"/>
        </Style>
    </UserControl.Styles>
    <Grid>
        <Border Classes="editor-toolbar-host top"
                IsVisible="{Binding ShowToolbars}"
                VerticalAlignment="Top"
                HorizontalAlignment="Stretch"
                IsHitTestVisible="{Binding ShowToolbars}">
            <controls:AnnotationToolbar x:Name="AnnotationToolbarControl"
                                        DataContext="{Binding ToolbarAdapter}"
                                        ShowEditingActions="False"
                                        HorizontalAlignment="Stretch"/>
        </Border>
    </Grid>
</UserControl>
